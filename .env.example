# Autonomous arXiv Paper Digest & QA Agent Configuration

# Required LLM Credential:
# Groq API key (free tier available at https://console.groq.com/keys)
GROQ_API_KEY=

# Groq Model (default: openai/gpt-oss-120b, or openai/gpt-oss-20b)
GROQ_MODEL=openai/gpt-oss-120b

# Embedding Model (local sentence-transformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Storage paths
CHROMA_PERSIST_DIR=./chroma_db
PDF_DOWNLOAD_DIR=./downloads

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
